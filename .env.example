DATABASE_URL=postgresql+psycopg://dococr:dococr@db:5432/dococr
REDIS_URL=redis://redis:6379/0
STORAGE_PATH=/data/originals
OCR_BATCH_SIZE=4
OCR_RECHECK_CONFIDENCE=0.75
OCR_MIN_CHARS=8
# The bundled llama.cpp service serves Surya 2 locally on the Docker network.
SURYA_INFERENCE_BACKEND=llamacpp
SURYA_INFERENCE_URL=http://surya:8080/v1
SURYA_INFERENCE_PARALLEL=1
# OpenAI-compatible document analysis model; required for real uploads.
# AI_BASE_URL=http://host.docker.internal:11434/v1
# AI_MODEL=your-json-capable-model
# AI_API_KEY=
AI_TIMEOUT_SECONDS=180
# Pre-OCR gate: provisional defaults, calibrate on representative labels.
QUALITY_BLUR_MIN=100
QUALITY_CONTRAST_MIN=20
QUALITY_SKEW_MAX=3
QUALITY_NOISE_MAX=8
QUALITY_TEXT_HEIGHT_MIN=12
QUALITY_MIN_SIDE=200
QUALITY_MAX_ATTEMPTS=1
QUALITY_CALIBRATION_ID=uncalibrated
QUALITY_DENOISE_ENABLED=true
QUALITY_DESKEW_ENABLED=true
QUALITY_CONTRAST_ENABLED=true
QUALITY_SHARPEN_ENABLED=true
QUALITY_UPSCALE_ENABLED=true
QUALITY_UPSCALE_MAX_FACTOR=4
QUALITY_UPSCALE_MAX_SIDE=3000
QUALITY_UPSCALE_MARGIN=1.35
